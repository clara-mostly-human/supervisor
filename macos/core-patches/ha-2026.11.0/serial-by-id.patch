+def _serial_by_id_links() -> dict[str, str]:
+    """Return each by-id link by the device node it points at."""
+    try:
+        with os.scandir(SERIAL_BY_ID_DIR) as entries:
+            return {
+                os.path.realpath(entry.path): entry.path
+                for entry in entries
+                if entry.is_symlink() and not entry.name.endswith(_BY_ID_TMP_SUFFIX)
+            }
+    except OSError:
+        return {}
+
