+def _drop_cached_json_fragments() -> None:
+    """Drop the orjson Fragments that Home Assistant objects cache.
+
+    orjson.Fragment does not keep a reference to its type, so a Fragment that
+    is still alive when the interpreter tears down its modules can outlive the
+    type and crash the process when it is freed. Home Assistant caches
+    Fragments on its own objects (propcache ``_cache`` dicts and
+    ``functools.cached_property``), and those objects can stay reachable until
+    then. Drop the cached Fragments while every module is still loaded.
+    """
+    fragment = orjson.Fragment
+    for obj in gc.get_objects():
+        module = getattr(type(obj), "__module__", None)
+        if not isinstance(module, str) or not module.startswith(
+            ("homeassistant.", "custom_components.")
+        ):
+            continue
+        try:
+            stores = (getattr(obj, "_cache", None), getattr(obj, "__dict__", None))
+        except Exception:  # noqa: BLE001
+            continue
+        for store in stores:
+            if type(store) is dict:
+                for key in [k for k, v in store.items() if type(v) is fragment]:
+                    del store[key]
 
 
