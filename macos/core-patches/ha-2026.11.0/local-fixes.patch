+    async def _async_stop_scanner(event: Event) -> None:
+        """Stop the scanner when Home Assistant stops."""
+        # Config entries are not unloaded at shutdown. Without this the
+        # scanner keeps running while the interpreter exits, and on macOS
+        # CoreBluetooth then delivers advertisements into a finalizing
+        # interpreter, which aborts the process.
+        await scanner.async_stop()
 
