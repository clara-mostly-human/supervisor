+def _drain_corebluetooth_autoreleases() -> None:
+    """Give each advertisement on macOS an autorelease pool of its own.
 
+    bleak handles advertisements on the event loop thread. That thread has no pool
+    that ever drains, so what PyObjC autoreleases there stays for the life of the
+    process: about 1 GB in 9 hours. bleak is not in this package and is reinstalled
+    with this integration's requirements, so it is wrapped from here.
+    """
+    if platform.system() != "Darwin":
+        return
+    try:
+        import objc  # noqa: PLC0415
 
+        from bleak.backends.corebluetooth.CentralManagerDelegate import (  # noqa: PLC0415
+            CentralManagerDelegate,
+        )
+
+        original = CentralManagerDelegate.did_discover_peripheral
+    except (ImportError, AttributeError) as err:
+        _LOGGER.warning("Autorelease fix for CoreBluetooth not applied: %s", err)
+        return
+    if getattr(original, "drains_autoreleases", False):
+        return
+
+    def did_discover_peripheral(self: Any, *args: Any) -> None:
+        with objc.autorelease_pool():
+            original(self, *args)
+
+    did_discover_peripheral.drains_autoreleases = True  # type: ignore[attr-defined]
+    CentralManagerDelegate.did_discover_peripheral = did_discover_peripheral
+
